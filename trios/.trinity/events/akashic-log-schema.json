  "description": "Schema for the Akashic event log — append-only journal of all significant agent and system events.",
  "file": ".trinity/events/akashic-log.jsonl",
  "format": "jsonl (one JSON object per line, append only)",
  "schema": {
    "ts": "integer (unix timestamp)",
    "agent": "string — agent letter or queen name (e.g., 'T', 'H', 'queen-browseros')",
    "action": "string — event type from canonical list",
    "road": "string | null — A, B, C, or null if not applicable",
    "ring": "string | null — SR-NNN, BR-OUTPUT, or null",
    "phase": "string | null — PHI LOOP phase or null",
    "issue": "string | null — GitHub issue #N or null",
    "status": "string — ok | warning | error | critical",
    "details": "object | null — free-form contextual data",
    "hash": "string | null — git commit hash or tri-cell seal hash"
  },
  "action_canonical_list": [
    "wake",
    "sleep",
    "plan",
    "assign",
    "run",
