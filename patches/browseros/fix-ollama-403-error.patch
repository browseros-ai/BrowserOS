 }
 
+/**
+ * Enhanced Ollama error handling for 403 errors
+ * This provides better user feedback and troubleshooting steps
+ */
+void ThirdPartyLlmPanelCoordinator::HandleOllamaError(int status_code, const std::string& error_message) {
+  if (status_code == 403) {
+    // Log detailed error information for debugging
+    LOG(ERROR) << "Ollama 403 error: " << error_message;
+     
+    // Show user-friendly error message with troubleshooting steps
+    std::string user_message = "Ollama access denied (403). ";
+     
+    if (error_message.find("CORS") != std::string::npos) {
+      user_message += "This is likely a CORS issue. Try running Ollama with: ollama serve --host 0.0.0.0";
+    } else if (error_message.find("model") != std::string::npos) {
+      user_message += "The specified model may not exist. Check available models with: ollama list";
+    } else {
+      user_message += "Check if Ollama is running and accessible at the configured URL.";
+    }
+     
+    // Display error to user (implementation depends on UI framework)
+    ShowErrorToUser(user_message);
+  } else {
+    // Handle other error codes
+    HandleGenericError(status_code, error_message);
+  }
+}
+
 void ThirdPartyLlmPanelCoordinator::OnOpenInNewTab() {
   if (!owned_web_contents_) {
     return;
