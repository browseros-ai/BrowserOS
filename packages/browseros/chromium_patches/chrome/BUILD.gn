       "//chrome/browser/resources/media/mei_preload:component",
       "//chrome/browser/web_applications/isolated_web_apps/key_distribution/preload:component",
       "//components/privacy_sandbox/privacy_sandbox_attestations/preload:component",
@@ -538,6 +542,7 @@ if (is_win) {
       "CHROMIUM_BUNDLE_ID=$chrome_mac_bundle_id",
       "CHROMIUM_SHORT_NAME=$chrome_product_short_name",
       "CHROMIUM_CREATOR=$chrome_mac_creator_code",
+      "BROWSEROS_PRODUCT_DIR_NAME=$browseros_product_dir_name",
     ]
 
     sources = [
@@ -556,6 +561,7 @@ if (is_win) {
       "//base/allocator:early_zone_registration_apple",
       "//build:branding_buildflags",
       "//build/config/compiler:compiler_buildflags",
+      "//chrome/browser/browseros/server:browseros_server_resources",
       "//chrome/common:buildflags",
       "//chrome/common:version_header",
     ]
@@ -1322,6 +1328,7 @@ if (is_win) {
       "//chrome/browser:chrome_process_singleton",
       "//chrome/browser:process_singleton",
       "//chrome/browser:startup_data",
+      "//chrome/browser/browseros/core",
       "//chrome/browser/lifetime",
       "//chrome/browser/mac",
       "//chrome/common:buildflags",
@@ -1395,6 +1402,9 @@ if (is_win) {
     if (is_chrome_branded) {
       bundle_deps += [ ":chromecompaneros_bundle_data" ]
     }
+
+    # Bundle the first-run extensions in the framework resource directory.
+    bundle_deps += [ "//chrome/browser/browseros/bundled_extensions" ]
     if (!use_static_angle) {
       bundle_deps += [ ":angle_binaries" ]
     }
@@ -1405,6 +1415,14 @@ if (is_win) {
       bundle_deps += [ ":chrome_renderer_library" ]
     }
 
+    # Sparkle lives inside this framework; expose its directory through the
+    # versioned bundle and resolve it relative to the framework binary.
+    if (enable_sparkle) {
+      bundle_deps += [ "//third_party/sparkle:sparkle_framework_bundle" ]
+      configs += [ "//third_party/sparkle:sparkle_link_framework" ]
+      framework_contents += [ "Frameworks" ]
+    }
+
     configs += [ ":chrome_dll_symbol_order" ]
     if (!is_component_build && !using_sanitizer) {
       configs += [ ":chrome_dll_symbol_exports" ]
@@ -2070,6 +2088,11 @@ if (enable_separate_renderer_binary) {
     "//content/public/app",
     "//v8",
   ]
+  if (!is_win) {
+    # These renderer targets compile the crash reporter client. Depend only on
+    # its BrowserOS constants, keeping the browser implementation out.
+    _chrome_renderer_deps += [ "//chrome/browser/browseros/core" ]
+  }
   if (is_win || is_linux || is_chromeos || is_mac) {
     _chrome_renderer_deps += [ "//components/webapps/isolated_web_apps:scheme" ]
   }
