# Windows Code Signing
ESIGNER_USERNAME=
ESIGNER_PASSWORD=
# TOTP secret (QR code secret) for 2FA
ESIGNER_TOTP_SECRET=
ESIGNER_CREDENTIAL_ID=
CODE_SIGN_TOOL_PATH=C:/src/CodeSignTool-v1.3.2-windows

# macOS Code Signing
MACOS_CERTIFICATE_NAME=
PROD_MACOS_NOTARIZATION_APPLE_ID=
PROD_MACOS_NOTARIZATION_TEAM_ID=
PROD_MACOS_NOTARIZATION_PWD=
# Optional local paths to the app-specific Developer ID profiles. Without a
# profile, the app still signs and runs but macOS platform passkeys stay off.
PROD_MACOS_BROWSEROS_PASSKEY_PROFILE_PATH=
PROD_MACOS_BROWSERCLAW_PASSKEY_PROFILE_PATH=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=browseros
R2_CDN_BASE_URL=http://cdn.browseros.com

# Slack Notifications
SLACK_WEBHOOK_URL=

# Sparkle Signing (macOS only)
SPARKLE_PRIVATE_KEY=
# Path to sign_update tool
SPARKLE_SIGN_UPDATE_PATH=

# Optional
# CHROMIUM_SRC=C:/src/chromium/src
# DEPOT_TOOLS_WIN_TOOLCHAIN=0
