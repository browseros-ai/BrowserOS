  {
    "path": "/chat",
    "method": "post",
    "pathRef": "./paths/chat.yaml#/collection",
    "operationId": "createChat",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../schemas/chat.yaml#/ChatRequest"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "AI SDK v7 UI message stream, x-vercel-ai-ui-message-stream: v1. SSE data: <UiMessageChunk JSON> followed by a blank line; terminal data: [DONE]. Disconnect only detaches the subscriber; it never cancels the run.",
        "headers": {
          "x-vercel-ai-ui-message-stream": {
            "schema": {
              "type": "string",
              "enum": ["v1"]
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "enum": ["no-cache"]
            }
          },
          "Connection": {
            "schema": {
              "type": "string",
              "enum": ["keep-alive"]
            }
          },
          "x-accel-buffering": {
            "schema": {
              "type": "string",
              "enum": ["no"]
            }
          }
        },
        "content": {
          "text/event-stream": {
            "schema": {
              "type": "string"
            },
            "x-event-schema": {
              "$ref": "../schemas/ui_stream.yaml#/UiMessageChunk"
            }
          }
        }
      },
      "400": {
        "$ref": "../responses.yaml#/BadRequest"
      },
      "403": {
        "$ref": "../responses.yaml#/Forbidden"
      },
      "404": {
        "$ref": "../responses.yaml#/NotFound"
      },
      "409": {
        "description": "An agent turn is already running",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common.yaml#/StringError"
            }
          }
        }
      },
      "500": {
        "$ref": "../responses.yaml#/InternalError"
      }
    }
  },
