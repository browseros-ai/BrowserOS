{
  "name": "@browseros/claw-app",
  "type": "module",
  "private": true,
  "version": "0.2.11",
  "description": "WXT extension surface for BrowserClaw. React + shadcn (base-vega). Uses generated BrowserClaw API DTOs.",
  "scripts": {
    "dev": "bun --env-file=../../.env.development wxt",
    "dev:web": "serve dist/chrome-mv3-dev -p 5174 --no-clipboard",
    "build": "wxt build",
    "build:dev": "bun --env-file=../../.env.development wxt build --mode development",
    "test": "wxt prepare && bun run ../../scripts/run-bun-test.ts ./apps/claw-app",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "bunx biome check",
    "lint:fix": "bunx biome check --write --unsafe",
    "lint:doctor": "bunx react-doctor@latest -y --verbose"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@browseros/claw-api": "workspace:*",
    "@browseros/claw-api-client": "workspace:*",
    "@browseros/shared": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@rive-app/react-webgl2": "^4.31.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "ai": "6.0.230",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.577.0",
    "media-chrome": "^4.19.1",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.414.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "~7.85.0",
    "react-jsx-parser": "^2.4.1",
    "react-query-kit": "^3.3.1",
    "react-router": "^7.18.2",
    "rrweb": "2.1.1",
    "rrweb-player": "2.1.1",
    "shiki": "^4.2.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.4.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "linkedom": "^0.18.13",
    "serve": "^14.2.6",
    "tailwindcss": "^4.1.17",
    "web-ext": "^9.2.0",
    "wxt": "^0.21.4"
  }
}
