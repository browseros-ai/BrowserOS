{
  // WXT owns import aliases. The test command prepares this base before Bun runs.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "types": ["chrome", "bun"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    // wxt 0.21's generated base turns on noUncheckedIndexedAccess and verbatimModuleSyntax; opt back out until the codebase adopts them deliberately.
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": false
  }
}
