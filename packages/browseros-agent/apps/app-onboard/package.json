{
  "name": "@browseros/app-onboard",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone Vite app for the BrowserOS onboarding flow (app theme, base-ui).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:chromium": "tsc --noEmit && vite build --mode chromium && bun scripts/verify-chromium-build.ts",
    "preview": "vite preview",
    "test": "bun run ../../scripts/run-bun-test.ts --cwd=./apps/app-onboard ./apps/app-onboard",
    "typecheck": "tsc --noEmit",
    "lint": "bunx biome check",
    "lint:fix": "bunx biome check --write --unsafe"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@lobehub/icons": "^2.48.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.17",
    "vite": "^7.3.6"
  }
}
