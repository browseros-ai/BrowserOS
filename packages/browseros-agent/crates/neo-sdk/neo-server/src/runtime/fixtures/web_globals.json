[
  {
    "name": "parse/basic",
    "code": "return parts(new URL(\"https://example.com\"))",
    "expected": {
      "ok": [
        "https://example.com/",
        "https://example.com",
        "https:",
        "",
        "",
        "example.com",
        "example.com",
        "",
        "/",
        "",
        ""
      ]
    }
  },
  {
    "name": "parse/normalize",
    "code": "return parts(new URL(\"HTTPS://EXAMPLE.COM:443/a/./b/../c?q=1#h\"))",
    "expected": {
      "ok": [
        "https://example.com/a/c?q=1#h",
        "https://example.com",
        "https:",
        "",
        "",
        "example.com",
        "example.com",
        "",
        "/a/c",
        "?q=1",
        "#h"
      ]
    }
  },
  {
    "name": "parse/userinfo",
    "code": "return parts(new URL(\"http://user:pa ss@host:8080/p\"))",
