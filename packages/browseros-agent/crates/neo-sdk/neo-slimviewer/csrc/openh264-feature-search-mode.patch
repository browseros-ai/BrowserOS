+enum FeatureSearchMode { kSearchOnScroll, kSearchUpstream, kSearchDisabled };
+
+static FeatureSearchMode ReadFeatureSearchMode() {
+  const char* mode = getenv ("SV_OPENH264_FME");
+  if (!mode || strcmp (mode, "scroll") == 0) return kSearchOnScroll;
+  if (strcmp (mode, "always") == 0) return kSearchUpstream;
+  if (strcmp (mode, "never") == 0) return kSearchDisabled;
+  fprintf (stderr, "OpenH264: unknown SV_OPENH264_FME value, using scroll\n");
+  return kSearchOnScroll;
+}
