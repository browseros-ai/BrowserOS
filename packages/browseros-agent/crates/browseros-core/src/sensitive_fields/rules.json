{
  "excludedTypes": [
    "button",
    "checkbox",
    "color",
    "date",
    "datetime-local",
    "file",
    "hidden",
    "image",
    "month",
    "radio",
    "range",
    "reset",
    "submit",
    "time",
    "week"
  ],
  "passwordTypes": ["password"],
  "passwordTokens": ["current-password", "new-password"],
  "oneTimeCodeTokens": ["one-time-code"],
  "cardTokenPrefixes": ["cc-"],
  "codeSlot": {
    "maxLength": 1,
    "inputModes": ["numeric", "decimal", "tel", "number"],
    "context": "verification|authentication|one.?time|sign.?in code|security code"
  },
  "words": [
    { "kind": "card", "pattern": "card.?(number|no)|credit.?card|cvv|cvc|csc" },
    { "kind": "password", "pattern": "password|passcode|\\bpin\\b" },
    {
      "kind": "one_time_code",
      "pattern": "\\botp\\b|one.?time|verification.?code|security.?code|auth(entication)?.?code"
    }
  ],
  "formTextLimit": 4096
}
