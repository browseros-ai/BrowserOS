{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/server/src/index.ts",
    "apps/server/src/compiled-bootstrap.ts",
    "apps/claw-onboard/src/main.tsx",
    "apps/app-onboard/src/main.tsx",
    "apps/app/entrypoints/app/main.tsx",
    "apps/app/entrypoints/sidepanel/main.tsx",
    "apps/app/entrypoints/background/index.ts",
    "apps/app/entrypoints/content.ts",
    "apps/app/entrypoints/auth.content/index.ts",
    "apps/app/entrypoints/glow.content/index.ts",
    "apps/app/entrypoints/selection.content.ts",
    "scripts/run-bun-test.ts",
    "scripts/dev/inspect-ui.ts",
    "scripts/patch-windows-exe.ts",
    "crates/neo-sdk/neo-server/src/runtime/js/abort_globals.js",
    "crates/neo-sdk/neo-playwright-tests/node/filechooser-lifetime.test.mjs",
    "packages/agent-cursor/src/index.ts",
    "packages/agent-cursor/scripts/classic-entry.ts",
    "crates/neo-sdk/neo-server/conformance/conformance.mjs",
    "crates/neo-sdk/neo-server/conformance/src/diagnostic-plugin.cjs",
    "crates/neo-sdk/neo-playwright-js/src/probe/index.ts",
    "crates/neo-sdk/neo-playwright-js/src/prelude/index.ts",
    "crates/neo-sdk/neo-playwright-js/src/main-world/index.ts",
    "crates/neo-sdk/neo-playwright-js/scripts/build.ts",
    "crates/neo-sdk/neo-playwright-js/scripts/probe-smoke.mjs",
    "crates/neo-sdk/neo-playwright-js/scripts/capture-goldens.mjs",
    "crates/neo-sdk/neo-playwright-js/scripts/port-keyboard-layout.ts",
    "crates/neo-sdk/neo-playwright-js/scripts/capture-snapshot-fixture.mjs",
    "crates/neo-sdk/neo-playwright-js/src/stubs/highlight.ts",
    "crates/neo-sdk/neo-playwright-js/src/stubs/consoleApi.ts",
    "crates/neo-sdk/neo-playwright-js/src/stubs/selectorEngine.ts",
    "crates/neo-sdk/neo-playwright-js/src/stubs/protocol/structs.ts",
    "crates/neo-sdk/neo-playwright-js/src/prelude/vendored-globals.ts",
    "crates/neo-sdk/neo-playwright-js/src/probe/masked-strings.ts"
  ],
  "ignoreDependencies": [
    "tailwind-scrollbar-hide",
    "tw-animate-css",
    "@tailwindcss/typography",
    "pino-pretty",
    "dotenv",
    "picocolors",
    "@browseros/cdp-protocol"
  ],
  "ignoreUnresolvedImports": ["@/assets/**", "@/styles/global.css"],
  "ignorePatterns": [
    "**/*.d.ts",
    "**/dist/**",
    "**/node_modules/**",
    "**/*.css",
    "**/.wxt/**",
    "**/.output/**",
    "**/coverage/**",
    "**/tmp/**",
    ".scripts/**",
    "apps/app/schema/**",
    "apps/app/assets/**",
    "apps/app/generated/**",
    "apps/app/public/**",
    "apps/server/src/lib/db/migrations/**",
    "packages/cdp-protocol/src/generated/**",
    ".agents/skills/**",
    ".claude/skills/**",
    "packages/agent-cursor/playground/**",
    "crates/neo-sdk/neo-playwright/third_party/**",
    "crates/neo-sdk/neo-playwright/assets/**"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "unused-optional-dependencies": "warn",
    "unused-enum-members": "warn",
    "private-type-leaks": "warn",
    "unresolved-imports": "warn",
    "unlisted-dependencies": "warn",
    "circular-dependencies": "warn",
    "unused-class-members": "off",
    "duplicate-exports": "off"
  },
  "overrides": [
    {
      "files": ["packages/agent-cursor/src/**"],
      "rules": {
        "unused-exports": "off",
        "private-type-leaks": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/tests/**",
        "**/*.config.ts"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    },
    {
      "files": [
        "apps/app/components/ui/**",
        "apps/app/components/ai-elements/**",
        "apps/app-onboard/src/components/ui/**"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off",
        "unused-types": "off",
        "private-type-leaks": "off"
      }
    }
  ]
}
