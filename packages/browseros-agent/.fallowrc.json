{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/claw-onboard/src/main.tsx",
    "scripts/run-bun-test.ts",
    "scripts/dev/inspect-ui.ts",
    "scripts/patch-windows-exe.ts",
    "packages/agent-cursor/src/index.ts",
    "packages/agent-cursor/scripts/classic-entry.ts"
  ],
  "ignoreDependencies": [
    "tailwind-scrollbar-hide",
    "tw-animate-css",
    "@tailwindcss/typography",
    "pino-pretty",
    "dotenv",
    "picocolors",
    "@browseros/cdp-protocol"
  ],
  "ignoreUnresolvedImports": ["@/assets/**", "@/styles/global.css"],
  "ignorePatterns": [
    "**/*.d.ts",
    "**/dist/**",
    "**/node_modules/**",
    "**/*.css",
    "**/.wxt/**",
    "**/.output/**",
    "**/coverage/**",
    "**/tmp/**",
    ".scripts/**",
    "packages/cdp-protocol/src/generated/**",
    ".agents/skills/**",
    ".claude/skills/**",
    "packages/agent-cursor/playground/**"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "unused-optional-dependencies": "warn",
    "unused-enum-members": "warn",
    "private-type-leaks": "warn",
    "unresolved-imports": "warn",
    "unlisted-dependencies": "warn",
    "circular-dependencies": "warn",
    "unused-class-members": "off",
    "duplicate-exports": "off"
  },
  "overrides": [
    {
      "files": ["packages/agent-cursor/src/**"],
      "rules": {
        "unused-exports": "off",
        "private-type-leaks": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/tests/**",
        "**/*.config.ts"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    }
  ]
}
