{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "bun.lock",
    "bunfig.toml",
    "tsconfig.json",
    "biome.json",
    "Cargo.toml",
    "Cargo.lock",
    "turbo.json"
  ],
  "globalEnv": ["CI"],
  "globalPassThroughEnv": ["BROWSEROS_*", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**", ".wxt/**", "build/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
    },
    "test": {
      "outputs": ["test-results/**", "coverage/**"]
    },
    "lint:rust": {
      "cache": false
    },
    "test:rust": {
      "cache": false
    }
  }
}
