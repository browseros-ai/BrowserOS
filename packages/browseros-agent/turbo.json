{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "codegen": {
      "outputs": ["generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", ".output/**", "build/**", "lib/**", "out/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "codegen"],
      "cache": false
    }
  }
}
