# BlockBrowser Mobile - Environment Variables Example
# Copy this file to .env and fill in your values

# Note: API keys should be configured in the app's Settings screen
# This file is for build-time configuration only

# Expo Project ID (get from expo.dev)
# EXPO_PROJECT_ID=

# App Environment
NODE_ENV=development

# Optional: Custom API endpoints
# BLOCKBROWSER_API_URL=https://api.blockbrowser.com
