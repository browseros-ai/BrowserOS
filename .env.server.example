# ===================================
# BrowserOS Headless Server Configuration
# ===================================
# คัดลอกไฟล์นี้เป็น .env.server แล้วแก้ไขค่าตามต้องการ
# cp .env.server.example .env.server

# พอร์ตที่ server รัน (ค่าเริ่มต้น: 3100)
HEADLESS_PORT=3100

# โฮสต์ที่ bind (ค่าเริ่มต้น: 0.0.0.0 รับทุก interface)
HEADLESS_HOST=0.0.0.0

# พาธไปยัง Chromium binary
# Linux: /usr/bin/chromium-browser หรือ /usr/bin/google-chrome
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMIUM_PATH=/usr/bin/chromium-browser

# โหมด debug — แสดง log ละเอียด (true/false)
HEADLESS_DEBUG=false

# API key สำหรับยืนยันตัวตน (เว้นว่าง = ไม่ต้องยืนยัน)
HEADLESS_API_KEY=

# เวลารอโหลดหน้าเว็บสูงสุด (มิลลิวินาที)
PAGE_LOAD_TIMEOUT=30000

# เวลารอหา element สูงสุด (มิลลิวินาที)
WAIT_TIMEOUT=10000

# ขนาด viewport (พิกเซล)
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# โฟลเดอร์เก็บ user data (cookies, localStorage, ฯลฯ)
USER_DATA_DIR=/tmp/browseros-headless-user-data

# ===================================
# AI Provider Keys (สำหรับ /api/chat)
# ===================================
ZAI_API_KEY=your_zai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
