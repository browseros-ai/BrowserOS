#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_ROOT"
pkill -9 -f "\.browseros-dev-chrome" 2>/dev/null || true
pkill -9 -f "apps/server/src/index.ts" 2>/dev/null || true
pkill -9 -f "@browseros/server start:ci" 2>/dev/null || true
rm -f /tmp/browseros-dev-browser.pid /tmp/browseros-dev-server.pid
