#!/usr/bin/env bash
set -euo pipefail
# mise executes this from the project root (where .mise.toml lives)
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# Fallback: if mise runs from project root, use pwd
[[ -d "${REPO_ROOT}/packages/browseros-agent" ]] || REPO_ROOT="$(pwd)"
cd "${REPO_ROOT}/packages/browseros-agent"

# Ensure desktop entries are registered
"$REPO_ROOT/scripts/setup-desktop-entries.sh" 2>/dev/null || true
update-desktop-database ~/.local/share/applications/ 2>/dev/null || true
APP="${BROWSEROS_APP_PATH:-$HOME/Downloads/alta/BrowserOS.AppImage}"
EXT_DIR="apps/agent/dist/chrome-mv3-dev"
BROWSER_LOG="/tmp/browseros-dev-browser.log"
SERVER_LOG="/tmp/browseros-dev-server.log"

if [ ! -x "$APP" ]; then
  echo "[ERROR] BrowserOS AppImage missing: $APP" >&2
  echo "        Set BROWSEROS_APP_PATH env var to override." >&2
  exit 1
fi

if [ ! -d "$EXT_DIR" ]; then
  echo "[ERROR] Dev extension build missing: $EXT_DIR" >&2
  exit 1
fi

nohup "$APP" \
  --no-sandbox \
  --no-first-run \
  --no-default-browser-check \
  --use-mock-keychain \
  --show-component-extension-options \
  --disable-browseros-server \
  --disable-browseros-extensions \
  --name=BrowserOS-Dev \
  --remote-debugging-port="${BROWSEROS_CDP_PORT:-9010}" \
  --browseros-mcp-port="${BROWSEROS_SERVER_PORT:-9110}" \
  --browseros-server-port="${BROWSEROS_SERVER_PORT:-9110}" \
  --user-data-dir="$HOME/.browseros-dev-chrome" \
  --load-extension="$EXT_DIR" \
  chrome://newtab \
  > "$BROWSER_LOG" 2>&1 &
echo $! > /tmp/browseros-dev-browser.pid

python3 - <<"PY"
import socket, time, sys
port = int(__import__('os').environ.get('BROWSEROS_CDP_PORT', '9010'))
for _ in range(60):
    s = socket.socket()
    s.settimeout(0.5)
    try:
        s.connect(("127.0.0.1", port))
        s.close()
        sys.exit(0)
    except OSError:
        time.sleep(0.5)
print(f"[ERROR] BrowserOS CDP port {port} did not open", file=sys.stderr)
sys.exit(1)
PY

nohup env \
  BROWSEROS_SKIP_OPENCLAW=1 \
  BROWSEROS_CDP_PORT="${BROWSEROS_CDP_PORT:-9010}" \
  BROWSEROS_SERVER_PORT="${BROWSEROS_SERVER_PORT:-9110}" \
  BROWSEROS_EXTENSION_PORT="${BROWSEROS_EXTENSION_PORT:-9305}" \
  bun run --filter @browseros/server start:ci \
  > "$SERVER_LOG" 2>&1 &
echo $! > /tmp/browseros-dev-server.pid

python3 - <<"PY"
import json, time, urllib.request, sys, os
port = os.environ.get('BROWSEROS_SERVER_PORT', '9110')
url = f"http://127.0.0.1:{port}/health"
for _ in range(60):
    try:
        with urllib.request.urlopen(url, timeout=1) as r:
            data = json.load(r)
        if data.get("status") == "ok" and data.get("cdpConnected") is True:
            print(json.dumps(data))
            sys.exit(0)
    except Exception:
        time.sleep(0.5)
print(f"[ERROR] BrowserOS server health check failed on {url}", file=sys.stderr)
sys.exit(1)
PY
